<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme with Material 3 guidelines -->
    <style name="Base.Theme.RentATool" parent="Theme.Material3.Light.NoActionBar">
        <!-- Primary color scheme -->
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/transparent</item>
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/transparent</item>



    </style>

    <!--custom toolbar text size-->
    <style name="ToolbarTitle.Small" parent="TextAppearance.Widget.AppCompat.Toolbar.Title">
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Theme.RentATool" parent="Base.Theme.RentATool" />
</resources>
