<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="6dp">

    <LinearLayout
        android:orientation="vertical"
        android:padding="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Order Date -->
        <TextView
            android:id="@+id/tv_order_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Order Date: 2025-07-23"
            android:textColor="@color/black"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Estimated Return Date -->
        <TextView
            android:id="@+id/tv_estimated_return"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Estimated Return: 2025-07-27"
            android:textColor="@color/black"
            android:textSize="14sp" />

        <!-- Total Rent -->
        <TextView
            android:id="@+id/tv_rent_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rent: Rs 2500"
            android:textColor="@color/black"
            android:textSize="14sp" />

        <!-- Status -->
        <TextView
            android:id="@+id/tv_order_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Status: Not Returned"
            android:textColor="@android:color/holo_red_dark"
            android:textSize="14sp" />

        <!-- Return Tools Button -->
        <Button
            android:id="@+id/btn_return_tools"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Return Tools"
            android:visibility="visible" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
