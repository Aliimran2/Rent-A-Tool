<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <!-- Order Summary Header -->
    <TextView
        android:id="@+id/tv_order_summary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Rental Order Details"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Order Info -->
    <TextView
        android:id="@+id/tv_order_info"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Order ID: 5\nDate: 23 July 2025\nTotal Rent: Rs. 3200\nStatus: Partially Returned"
        android:layout_marginTop="8dp"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/tv_order_summary"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Tools List Label -->
    <TextView
        android:id="@+id/tv_tools_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tools in this Order:"
        android:textStyle="bold"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/tv_order_info"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Tool List Scroll -->
    <ScrollView
        android:id="@+id/scroll_tool_items"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/tv_tools_label"
        app:layout_constraintBottom_toTopOf="@id/btn_close"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/container_tool_items"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <!-- Close Button -->
    <Button
        android:id="@+id/btn_close"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Close"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
