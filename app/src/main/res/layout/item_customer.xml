<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    app:cardCornerRadius="12dp"

    android:elevation="8dp"
    >

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp"
        >


        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/iv_customer"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/place_holder_image"
            app:civ_border_color="@color/civ_border"
            app:civ_border_width="2dp"
            app:layout_constraintBottom_toBottomOf="@+id/tv_customer_name"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_customer_name" />


        <TextView
            android:id="@+id/tv_customer_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="8dp"
            android:textSize="16sp"
            android:textAllCaps="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/iv_customer"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Muhammad Imran Ali Sajid" />

        <com.google.android.material.divider.MaterialDivider
            android:id="@+id/view"
            android:layout_width="0dp"
            android:layout_height="2dp"
            android:layout_marginTop="2dp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/tv_customer_name"
            app:layout_constraintTop_toBottomOf="@+id/tv_customer_name" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/customer_ledger_btn"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:text="@string/ledger"
            android:textSize="10sp"
            app:layout_constraintBottom_toBottomOf="@+id/customer_rentals_btn"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toEndOf="@+id/customer_rentals_btn"
            app:layout_constraintTop_toTopOf="@+id/customer_rentals_btn" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/customer_rentals_btn"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginEnd="2dp"
            android:text="@string/rentals"
            android:textSize="10sp"
            app:layout_constraintBottom_toBottomOf="@+id/toolSelectionBtn"
            app:layout_constraintEnd_toStartOf="@+id/customer_ledger_btn"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toEndOf="@+id/toolSelectionBtn"
            app:layout_constraintTop_toTopOf="@+id/toolSelectionBtn" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/toolSelectionBtn"
            android:layout_width="0dp"

            android:layout_height="40dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="2dp"
            android:text="@string/rent_tools"
            android:textSize="8sp"
            app:layout_constraintEnd_toStartOf="@+id/customer_rentals_btn"
            app:layout_constraintHorizontal_chainStyle="spread"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/view" />

        <!--        <com.google.android.material.divider.MaterialDivider-->
        <!--            android:layout_width="0dp"-->
        <!--            android:layout_height="2dp"-->
        <!--            android:layout_marginTop="4dp"-->
        <!--            app:layout_constraintBottom_toBottomOf="parent"-->
        <!--            app:layout_constraintEnd_toEndOf="parent"-->
        <!--            app:layout_constraintStart_toStartOf="parent"-->
        <!--            app:layout_constraintTop_toBottomOf="@+id/customer_rentals_btn" />-->


    </androidx.constraintlayout.widget.ConstraintLayout>


</androidx.cardview.widget.CardView>
