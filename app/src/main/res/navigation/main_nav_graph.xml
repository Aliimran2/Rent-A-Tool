<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_nav_graph"
    app:startDestination="@id/customersListFragment">

    <fragment
        android:id="@+id/stockFragment"
        android:name="com.miassolutions.rentatool.ui.fragments.lists.StockFragment"
        android:label="Stock"
        tools:layout="@layout/fragment_stock"/>
    <fragment
        android:id="@+id/addCustomerFragment"
        android:name="com.miassolutions.rentatool.ui.fragments.entry.AddCustomerFragment"
        android:label="Add A New Customer"
        tools:layout="@layout/fragment_add_customer" />
    <fragment
        android:id="@+id/addToolFragment"
        android:name="com.miassolutions.rentatool.ui.fragments.entry.AddToolFragment"
        android:label="Add A New Tool"
        tools:layout="@layout/fragment_add_tool" />
    <fragment
        android:id="@+id/customerDetailsFragment"
        android:name="com.miassolutions.rentatool.ui.fragments.others.CustomerDetailsFragment"
        android:label="@string/customer_details"
        tools:layout="@layout/fragment_customer_details" >
        <argument
            android:name="customerId"
            app:argType="long" />
        <action
            android:id="@+id/action_customerDetailsFragment_to_updateCustomerFragment"
            app:destination="@id/updateCustomerFragment" />
    </fragment>
    <fragment
        android:id="@+id/customersListFragment"
        android:name="com.miassolutions.rentatool.ui.fragments.lists.CustomersListFragment"
        android:label="@string/customers"
        tools:layout="@layout/fragment_customers_list">
        <action
            android:id="@+id/action_customersListFragment_to_customerDetailsFragment"
            app:destination="@id/customerDetailsFragment" />
        <action
            android:id="@+id/action_customersListFragment_to_customerManagerFragment"
            app:destination="@id/customerManagerFragment" />
    </fragment>
    <fragment
        android:id="@+id/rentToolFragment"
        android:name="com.miassolutions.rentatool.ui.fragments.rentalrecord.RentToolFragment"
        android:label="Rent Tools"
        tools:layout="@layout/fragment_rent_tool" >
        <action
            android:id="@+id/action_rentToolFragment_to_confirmDialogFragment"
            app:destination="@id/confirmDialogFragment" />
    </fragment>
    <fragment
        android:id="@+id/rentalFragment"
        android:name="com.miassolutions.rentatool.ui.fragments.rentalrecord.RentalFragment"
        android:label="Rentals"
        tools:layout="@layout/fragment_rental"/>
    <fragment
        android:id="@+id/updateCustomerFragment"
        android:name="com.miassolutions.rentatool.ui.fragments.others.UpdateCustomerFragment"
        android:label="Update {customerName}"
        tools:layout="@layout/fragment_update_customer">
        <argument
            android:name="customerId"
            app:argType="long" />
        <action
            android:id="@+id/action_updateCustomerFragment_to_customersListFragment"
            app:destination="@id/customersListFragment"
            app:popUpTo="@id/customersListFragment"
            app:popUpToInclusive="true" />
        <argument
            android:name="customerName"
            app:argType="string" />
    </fragment>
    <fragment
        android:id="@+id/confirmDialogFragment"
        tools:layout="@layout/fragment_confirm_dialog"
        android:name="com.miassolutions.rentatool.ui.fragments.ConfirmDialogFragment"
        android:label="ConfirmDialogFragment" />
    <fragment
        android:id="@+id/rentalDetailsFragment"
        android:name="com.miassolutions.rentatool.ui.fragments.rentalrecord.RentalDetailsFragment"
        android:label="fragment_rental_details"
        tools:layout="@layout/fragment_rental_details" >
        <argument
            android:name="rentalId"
            app:argType="long" />
    </fragment>
    <fragment
        android:id="@+id/customerManagerFragment"
        android:name="com.miassolutions.rentatool.ui.fragments.rentalrecord.CustomerManagerFragment"
        android:label="{customerName}"
        tools:layout="@layout/fragment_customer_manager" >
        <argument
            android:name="customerId"
            app:argType="long" />
        <argument
            android:name="customerName"
            app:argType="string" />
        <action
            android:id="@+id/action_customerManagerFragment_to_toolSelectionFragment"
            app:destination="@id/toolSelectionFragment" />
        <action
            android:id="@+id/action_customerManagerFragment_to_rentalDetailsFragment"
            app:destination="@id/rentalDetailsFragment" />
    </fragment>
    <fragment
        android:id="@+id/returnedFragment"
        android:name="com.miassolutions.rentatool.ReturnedFragment"
        android:label="fragment_returned"
        tools:layout="@layout/fragment_returned" />
    <fragment
        android:id="@+id/toolSelectionFragment"
        android:name="com.miassolutions.rentatool.ui.fragments.rentalrecord.ToolSelectionFragment"
        android:label="Tool Selection: {customerName}"
        tools:layout="@layout/fragment_tool_selection">
        <argument
            android:name="customerId"
            app:argType="long" />
        <argument
            android:name="customerName"
            app:argType="string" />
    </fragment>
</navigation>