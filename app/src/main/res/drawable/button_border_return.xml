<!-- res/drawable/button_border.xml -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="true">
        <shape>
            <!-- Lighter transparent greenish color -->
            <solid android:color="#33FF6D00"/> <!-- 20% opacity for greenish color -->
            <stroke android:color="#FF6D00" android:width="2dp"/> <!-- Solid orange border -->
            <corners android:radius="4dp"/> <!-- Rounded corners -->
        </shape>
    </item>
</selector>
